{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "system-nilelink",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "AUTH_SECRET": "nilelink_production_secure_jwt_secret_key_2026_enterprise",
    "CRON_SECRET": "nilelink_cron_secret_key_2026",
    "EMAIL_FROM": "no-reply@nilelinklogistics.com",
    "JWT_SECRET": "nilelink_production_secure_jwt_secret_key_2026_enterprise",
    "MONGODB_URI": "mongodb+srv://khaled:daidar@cluster0.ixyfdi0.mongodb.net/nilelink?appName=Cluster0&retryWrites=true&w=majority",
    "NEXT_PUBLIC_APP_URL": "https://system-nilelink.khaledhesham012.workers.dev/en",
    "WHATSAPP_API_URL": "https://graph.facebook.com/v19.0/your_phone_number_id/messages"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}