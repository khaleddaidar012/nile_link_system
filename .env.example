# ==============================================================================
# NileLink Portal Environment Configuration
# ==============================================================================

# Database Connection (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/nilelink

# JWT & Authentication Secrets
JWT_SECRET=nilelink_production_secure_jwt_secret_key_2026_enterprise
AUTH_SECRET=nilelink_production_secure_jwt_secret_key_2026_enterprise

# Cron Job Secret (for /api/cron/check-expiries)
CRON_SECRET=nilelink_cron_secret_key_2026

# Base App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Delivery (SMTP Settings - Optional for local dev)
EMAIL_FROM=no-reply@nilelink.com
EMAIL_SERVER_HOST=smtp.mailtrap.io
EMAIL_SERVER_PORT=2525
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# WhatsApp Business Cloud API (Optional for local dev)
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/your_phone_number_id/messages
WHATSAPP_API_TOKEN=your_whatsapp_bearer_token

# Cloudflare R2 Object Storage (S3-Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=nilelink-documents
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

